# Anthropic API key - server side only. This must never ship inside the app.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the app sends as x-cram-key. Raises the bar for casual abuse.
# NOT real security - it ships inside the binary and can be extracted.
# See README for the real fix before you scale.
CRAM_APP_KEY=change-me

# Swap models here if unit economics get tight. See README.
CRAM_MODEL=claude-opus-5
