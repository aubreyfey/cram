{
  "expo": {
    "name": "Cram",
    "slug": "cram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cram",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "splash": {
      "backgroundColor": "#0B0B0F",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cram.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Cram uses your camera to turn lecture slides, textbook pages and handwritten notes into flashcards.",
        "NSPhotoLibraryUsageDescription": "Import a screenshot or photo of your notes to turn it into flashcards.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appStoreUrl": ""
    },
    "android": {
      "package": "com.cram.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "playStoreUrl": ""
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cram uses your camera to turn your notes into flashcards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import a screenshot or photo of your notes to turn it into flashcards."
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#D4FF3F",
          "sounds": [
            "./assets/sounds/volt-alarm.wav"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "north-beam-llc",
          "project": "cram"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cram records you explaining what you learned, so you can listen back and turn it into cards."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cram records you explaining what you learned, so you can listen back and turn it into cards.",
          "speechRecognitionPermission": "Cram turns what you say into text, on your device, so it can become cards."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "appKey": "change-me",
      "unlockAll": false,
      "siteUrl": "https://cram.vercel.app",
      "feedbackEmail": "",
      "sentryDsn": "",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "shareUrl": "https://aubreyfey.github.io/cram/"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
