{
  "expo": {
    "name": "Cram",
    "slug": "cram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cram",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "splash": {
      "backgroundColor": "#0B0B0F",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cram.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Cram uses your camera to turn lecture slides, textbook pages and handwritten notes into flashcards.",
        "NSPhotoLibraryUsageDescription": "Import a screenshot or photo of your notes to turn it into flashcards.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cram.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cram uses your camera to turn your notes into flashcards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import a screenshot or photo of your notes to turn it into flashcards."
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#D4FF3F"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "appKey": "change-me",
      "unlockAll": false,
      "siteUrl": "https://cram.vercel.app"
    }
  }
}
